<Window x:Class="PetHelper.DialogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetHelper"
        Width="280" Height="380" MinWidth="220" MinHeight="240" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        AllowDrop="True"
        SizeChanged="DialogueWindow_SizeChanged" LocationChanged="DialogueWindow_LocationChanged"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:DialogueImageSourceConverter x:Key="ImageSourceConverter" />
    <Style x:Key="NarrowScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="Transparent" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NarrowScrollViewer" TargetType="{x:Type ScrollViewer}">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <ScrollContentPresenter />
              <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource NarrowScrollBar}"
                         Orientation="Vertical" HorizontalAlignment="Right"
                         Visibility="Collapsed" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#101828" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    CornerRadius="16" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#344054" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SubtleIconButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#667085" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#14000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#22000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="FileCardTemplate">
      <Border Background="#22000000" CornerRadius="4" Padding="6,2" Margin="0,2" MaxWidth="190"
              HorizontalAlignment="Left" ToolTip="{Binding Path}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                     TextTrimming="CharacterEllipsis" Foreground="#DD000000" />
          <TextBlock Text="{Binding Path}" Foreground="#AA000000" FontSize="9.5"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ImageThumbTemplate">
      <Border CornerRadius="6" Margin="0,2" Background="#11000000" Padding="2">
        <StackPanel>
          <Image MaxWidth="170" MaxHeight="110" Stretch="Uniform"
                 Source="{Binding Converter={StaticResource ImageSourceConverter}}" />
          <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="#99000000"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="UserBubbleTemplate">
      <Border CornerRadius="16" Padding="12,8" Margin="54,6,4,6" MaxWidth="220"
              HorizontalAlignment="Right"
              Background="#E8EDFF" BorderBrush="#557385FF" BorderThickness="1">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageThumbTemplate}" />
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileCardTemplate}" />
          <TextBox Text="{Binding Text}" TextWrapping="Wrap" Foreground="#1D2939"
                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="AssistantTextTemplate">
      <TextBox Text="{Binding Text}" TextWrapping="Wrap" Foreground="#1D2939"
               IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Padding="0" HorizontalContentAlignment="Left" />
    </DataTemplate>
    <DataTemplate x:Key="AssistantMarkdownTemplate">
      <RichTextBox x:Name="MarkdownHost" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                   Background="Transparent" BorderThickness="0" Foreground="#1D2939"
                   IsDocumentEnabled="True" HorizontalScrollBarVisibility="Disabled"
                   VerticalScrollBarVisibility="Disabled" Padding="0"
                   Loaded="MarkdownHost_Loaded" />
    </DataTemplate>
    <DataTemplate x:Key="AssistantDocumentTemplate">
      <StackPanel Margin="4,10,34,10" HorizontalAlignment="Stretch">
        <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageThumbTemplate}" />
        <ContentControl Content="{Binding}">
          <ContentControl.Style>
            <Style TargetType="{x:Type ContentControl}">
              <Setter Property="ContentTemplate" Value="{StaticResource AssistantMarkdownTemplate}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ShowStreaming}" Value="True">
                  <Setter Property="ContentTemplate" Value="{StaticResource AssistantTextTemplate}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ContentControl.Style>
        </ContentControl>
        <TextBlock Text="{Binding EndLabel}" FontWeight="SemiBold" Foreground="#667085"
                   Margin="0,6,0,0"
                   Visibility="{Binding ShowEnd, Converter={StaticResource BoolToVis}}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="MessageTemplate">
      <ContentControl Content="{Binding}">
        <ContentControl.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="ContentTemplate" Value="{StaticResource AssistantDocumentTemplate}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Role}" Value="user">
                <Setter Property="ContentTemplate" Value="{StaticResource UserBubbleTemplate}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="PendingAttachmentTemplate">
      <Border Background="#224D6BFE" CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" FontSize="10" Padding="3,0"
                  Background="Transparent" Foreground="#CC222222" BorderThickness="0"
                  Cursor="Hand" Tag="{Binding}" Click="RemoveAttachmentButton_Click" />
          <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center"
                     MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="#CC222222" />
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Border Background="#FFF8F9FC" CornerRadius="20" BorderBrush="#140F172A" BorderThickness="1"
            Margin="1">
      <Grid Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="28">
          <TextBlock Text="桌宠对话" Foreground="#344054" FontWeight="SemiBold" FontSize="13"
                     VerticalAlignment="Center" />
          <Button HorizontalAlignment="Right" Width="28" Height="28" Content="×"
                  Style="{StaticResource SubtleIconButton}" FontSize="18" Click="CloseButton_Click" ToolTip="关闭对话" />
        </Grid>
        <ScrollViewer Grid.Row="1" x:Name="MessageScroll" Style="{StaticResource NarrowScrollViewer}"
                      Margin="0,6,0,12" ScrollChanged="MessageScroll_ScrollChanged">
          <ItemsControl x:Name="MessageList" ItemTemplate="{StaticResource MessageTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel VirtualizingPanel.ScrollUnit="Pixel" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
        <Border x:Name="InputComposer" Grid.Row="2" Background="#D9FFFFFF" CornerRadius="18"
                BorderBrush="#2B98A2B3" BorderThickness="1" Padding="12,9,9,8">
          <StackPanel>
            <ItemsControl x:Name="PendingAttachmentsList" Visibility="Collapsed"
                          ItemTemplate="{StaticResource PendingAttachmentTemplate}" Margin="0,0,0,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <Grid MinHeight="30">
              <TextBlock x:Name="InputHint" Text="给智能体发消息" Foreground="#98A2B3"
                         FontSize="13" Margin="1,3,34,3" IsHitTestVisible="False" />
              <TextBox x:Name="InputTextBox" MinHeight="30" MaxHeight="72" AcceptsReturn="True"
                       TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       KeyDown="InputTextBox_KeyDown" TextChanged="InputTextBox_TextChanged"
                       Background="Transparent" BorderThickness="0" Padding="0,2,34,2"
                       Foreground="#1D2939" />
            </Grid>
            <DockPanel Margin="0,5,0,0" LastChildFill="True">
              <Button DockPanel.Dock="Right" x:Name="SendButton" Width="26" Height="26"
                      Style="{StaticResource AccentButton}" Click="SendButton_Click"
                      ToolTip="发送（Enter）">
                <Viewbox Width="16" Height="16">
                  <Path x:Name="SendGlyph" Fill="White"
                        Data="M 8,1 L 1,9 L 5.5,9 L 5.5,15 L 10.5,15 L 10.5,9 L 15,9 Z" />
                </Viewbox>
              </Button>
              <Button DockPanel.Dock="Left" Content="＋" Width="30" Height="30" FontSize="20"
                      Padding="0" Style="{StaticResource SubtleIconButton}"
                      Click="AttachmentButton_Click" ToolTip="添加图片或文件（也支持拖入）" />
              <TextBlock x:Name="ConversationStatusLabel" Foreground="#667085" FontSize="11.5"
                         VerticalAlignment="Center" Margin="5,0,8,0" TextWrapping="Wrap" />
            </DockPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
