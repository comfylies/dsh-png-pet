<Window x:Class="PetHelper.DialogueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PetHelper"
        Width="280" Height="380" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="CanResize"
        AllowDrop="True"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver" Drop="Window_Drop"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove" MouseLeftButtonUp="Window_MouseLeftButtonUp">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:DialogueImageSourceConverter x:Key="ImageSourceConverter" />
    <Style x:Key="NarrowScrollBar" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb Background="#66FFFFFF" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="NarrowScrollViewer" TargetType="{x:Type ScrollViewer}">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollViewer}">
            <Grid>
              <ScrollContentPresenter />
              <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource NarrowScrollBar}"
                         Orientation="Vertical" HorizontalAlignment="Right"
                         Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DeepSeekButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#4D6BFE" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="border" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#3A55E8" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#2E45C4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="FileCardTemplate">
      <Border Background="#22000000" CornerRadius="4" Padding="6,2" Margin="0,2" MaxWidth="190"
              HorizontalAlignment="Left" ToolTip="{Binding Path}">
        <StackPanel>
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11"
                     TextTrimming="CharacterEllipsis" Foreground="#DD000000" />
          <TextBlock Text="{Binding Path}" Foreground="#AA000000" FontSize="9.5"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="ImageThumbTemplate">
      <Border CornerRadius="6" Margin="0,2" Background="#11000000" Padding="2">
        <StackPanel>
          <Image MaxWidth="170" MaxHeight="110" Stretch="Uniform"
                 Source="{Binding Converter={StaticResource ImageSourceConverter}}" />
          <TextBlock Text="{Binding Name}" FontSize="9.5" Foreground="#99000000"
                     HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="UserBubbleTemplate">
      <Border CornerRadius="10" Padding="8,5" Margin="4,2" MaxWidth="205"
              HorizontalAlignment="Right"
              Background="#E8F0FB" BorderBrush="#40000000" BorderThickness="1">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageThumbTemplate}" />
          <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileCardTemplate}" />
          <TextBox Text="{Binding Text}" TextWrapping="Wrap" Foreground="#DD000000"
                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" HorizontalContentAlignment="Left" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="AssistantBubbleTemplate">
      <Border CornerRadius="10" Padding="8,5" Margin="4,2" MaxWidth="205"
              HorizontalAlignment="Left"
              Background="#EAF4EC" BorderBrush="#40000000" BorderThickness="1">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Images}" ItemTemplate="{StaticResource ImageThumbTemplate}" />
          <TextBox Text="{Binding Text}" TextWrapping="Wrap" Foreground="#DD000000"
                   IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Padding="0" HorizontalContentAlignment="Left"
                   Visibility="{Binding ShowStreaming, Converter={StaticResource BoolToVis}}" />
          <RichTextBox x:Name="MarkdownHost" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                       Background="Transparent" BorderThickness="0"
                       IsDocumentEnabled="True" HorizontalScrollBarVisibility="Disabled"
                       VerticalScrollBarVisibility="Disabled" Padding="0"
                       Loaded="MarkdownHost_Loaded"
                       Visibility="{Binding ShowMarkdown, Converter={StaticResource BoolToVis}}" />
          <TextBlock Text="{Binding EndLabel}" FontWeight="SemiBold" Foreground="#CC000000"
                     Margin="0,2,0,0"
                     Visibility="{Binding ShowEnd, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="MessageTemplate">
      <ContentControl Content="{Binding}">
        <ContentControl.Style>
          <Style TargetType="{x:Type ContentControl}">
            <Setter Property="ContentTemplate" Value="{StaticResource AssistantBubbleTemplate}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Role}" Value="user">
                <Setter Property="ContentTemplate" Value="{StaticResource UserBubbleTemplate}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </ContentControl.Style>
      </ContentControl>
    </DataTemplate>
    <DataTemplate x:Key="PendingAttachmentTemplate">
      <Border Background="#224D6BFE" CornerRadius="8" Padding="6,2" Margin="0,0,4,0">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" FontSize="10" Padding="3,0"
                  Background="Transparent" Foreground="#CC222222" BorderThickness="0"
                  Cursor="Hand" Tag="{Binding}" Click="RemoveAttachmentButton_Click" />
          <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center"
                     MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="#CC222222" />
        </DockPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Border Background="#F0FFFFFF" CornerRadius="12" BorderBrush="#40000000" BorderThickness="1"
            Margin="1">
      <Grid Margin="10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
          <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource DeepSeekButton}"
                  Click="CloseButton_Click" ToolTip="关闭对话" Padding="8,0" />
          <TextBlock Text="对话" Foreground="#CC222222" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="1" Margin="0,8,0,0" Background="#E8FFFFFF" CornerRadius="8"
                BorderBrush="#30000000" BorderThickness="1" Padding="4">
          <ScrollViewer x:Name="MessageScroll" Style="{StaticResource NarrowScrollViewer}"
                        ScrollChanged="MessageScroll_ScrollChanged">
            <ItemsControl x:Name="MessageList" ItemTemplate="{StaticResource MessageTemplate}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel VirtualizingPanel.ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
          <ItemsControl x:Name="PendingAttachmentsList" Visibility="Collapsed"
                        ItemTemplate="{StaticResource PendingAttachmentTemplate}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <TextBox x:Name="InputTextBox" MinHeight="36" MaxHeight="72" AcceptsReturn="True"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   KeyDown="InputTextBox_KeyDown" Background="#E8FFFFFF"
                   BorderBrush="#40000000" Margin="0,4,0,0" />
          <DockPanel Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" x:Name="SendButton" Content="发送"
                    Style="{StaticResource DeepSeekButton}"
                    Padding="14,4" Click="SendButton_Click" />
            <Button DockPanel.Dock="Right" Content="附件" Style="{StaticResource DeepSeekButton}"
                    Padding="10,4" Margin="0,0,4,0" Click="AttachmentButton_Click"
                    ToolTip="添加图片或文件（也支持拖入）" />
            <TextBlock x:Name="ConversationStatusLabel" Foreground="#AA000000"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
