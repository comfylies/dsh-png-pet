<Window x:Class="PetHelper.PeakValleyCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="168" Height="84" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">
  <Window.Resources>
    <Style x:Key="PeakValleyCloseButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#14000000" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#22000000" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="#F0FFFFFF" BorderBrush="#140F172A" BorderThickness="1"
          CornerRadius="20" Margin="1" Padding="14,8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="现在是：" Foreground="#101828" FontFamily="Microsoft YaHei UI"
                 FontSize="14" FontWeight="Normal" HorizontalAlignment="Left" />
      <TextBlock x:Name="PeriodLabel" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                 Margin="20,0,0,2" FontSize="30" FontWeight="SemiBold" />
      <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Top"
              Width="26" Height="26" Content="×" FontSize="18" FontWeight="Normal"
              Style="{StaticResource PeakValleyCloseButton}"
              ToolTip="关闭峰谷提示" AutomationProperties.Name="关闭峰谷提示"
              Click="CloseButton_Click" />
    </Grid>
  </Border>
</Window>
