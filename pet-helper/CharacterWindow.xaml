<Window x:Class="PetHelper.CharacterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="人物形象" Width="720" Height="780" MinWidth="680" MinHeight="630"
        WindowStartupLocation="CenterScreen" Background="#F7F8FC" Foreground="#273449"
        FontFamily="Microsoft YaHei UI" FontSize="13" ShowInTaskbar="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#D8DFEA" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#D8DFEA" />
    </Style>
    <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H20 V20 H0Z" />
          <GeometryDrawing Brush="#E9EDF3" Geometry="M0,0 H10 V10 H0Z M10,10 H20 V20 H10Z" />
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>
  </Window.Resources>
  <Grid Margin="22" Background="#F7F8FC">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="选择你的桌面伙伴" FontSize="23" FontWeight="SemiBold" />
      <TextBlock Text="本机保存，即时切换。人物形象不改变当前会话。" Foreground="#66758A" Margin="0,7,0,16" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
      <Button x:Name="AddImageButton" Content="添加 GIF / PNG" Click="AddImage_Click" />
      <Button x:Name="AddDirectoryButton" Content="添加角色目录" Click="AddDirectory_Click" />
      <Button x:Name="CancelImportButton" Content="取消导入" Click="CancelImport_Click" Visibility="Collapsed" />
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <ListBox x:Name="Characters" SelectionChanged="Characters_SelectionChanged"
               BorderBrush="#DEE4ED" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="3,8">
              <Image Source="{Binding Thumbnail}" Width="38" Height="38" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Label}" Width="110" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="PreviewTitle" Text="默认人物" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <Border Background="{StaticResource Checker}" BorderBrush="#DEE4ED" BorderThickness="1" HorizontalAlignment="Center">
            <Grid Width="240" Height="240">
              <Image x:Name="PreviewImage" Stretch="Uniform" />
              <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="HeadMarker" Width="10" Height="10" Stroke="White" StrokeThickness="2" Fill="#536FE8"/>
                <Line x:Name="FootMarker" X1="0" X2="240" Stroke="#E99836" StrokeThickness="1.5" StrokeDashArray="4,3"/>
              </Canvas>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
            <TextBlock Text="预览状态" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="PreviewState" Width="120" SelectionChanged="PreviewState_Changed"/>
            <CheckBox x:Name="StaticPreview" Content="静态预览" Margin="14,0,0,0" VerticalAlignment="Center"
                      Checked="PreviewMotion_Changed" Unchecked="PreviewMotion_Changed"/>
          </StackPanel>
          <StackPanel x:Name="ImportSettings" Visibility="Collapsed">
            <TextBlock Text="人物名称" Margin="0,4,0,5"/>
            <TextBox x:Name="CharacterName" MaxLength="40"/>
            <TextBlock Text="头顶位置（蓝点）：水平 / 垂直" Margin="0,10,0,4"/>
            <Slider x:Name="AnchorX" Minimum="0" Maximum="1" Value="0.5" SmallChange="0.01" ValueChanged="Anchor_Changed"/>
            <Slider x:Name="AnchorY" Minimum="0" Maximum="1" Value="0.12" SmallChange="0.01" ValueChanged="Anchor_Changed"/>
            <TextBlock Text="脚底基线（橙线）" Margin="0,7,0,4"/>
            <Slider x:Name="Baseline" Minimum="0" Maximum="1" Value="0.95" SmallChange="0.01" ValueChanged="Anchor_Changed"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock x:Name="Notice" Grid.Row="3" TextWrapping="Wrap" Foreground="#66758A" Margin="0,14,0,14"
               Text="GIF 按当前状态循环；缺少状态动作时使用该人物的待机动画。" />
    <DockPanel Grid.Row="4" LastChildFill="False">
      <Button x:Name="DeleteButton" Content="移除人物" Click="Delete_Click" DockPanel.Dock="Left"/>
      <Button x:Name="ApplyButton" Content="使用此人物" Click="Apply_Click" DockPanel.Dock="Right"
              Background="#536FE8" Foreground="White" BorderBrush="#536FE8" Margin="0"/>
      <Button x:Name="DefaultButton" Content="恢复默认" Click="Default_Click" DockPanel.Dock="Right"/>
    </DockPanel>
  </Grid>
</Window>
