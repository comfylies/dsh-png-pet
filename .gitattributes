# Normalize line endings across the repo
* text=auto

# Source files should use LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Windows-native C# projects keep CRLF
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.exe binary
*.dll binary
*.tgz binary
